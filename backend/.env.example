# Server Settings
PORT=8000
HOST=127.0.0.1
PROJECT_NAME="Smart Attendance System API"
API_V1_STR="/api"
DEBUG=True

# Database Settings
MONGODB_URL=mongodb://127.0.0.1:27017
DATABASE_NAME=smart_attendance_db

# Security & JWT Settings
JWT_SECRET_KEY=smart_attendance_dev_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Face Recognition Settings
FACE_MATCH_THRESHOLD=0.45
FACE_DETECTION_MODEL=hog
REQUIRED_FACE_SAMPLES=5

# CORS Settings (Comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
